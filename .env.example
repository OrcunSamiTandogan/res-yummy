# Yönetim paneli (/admin) için gerekli ortam değişkenleri.
# Yerelde .env.local olarak kopyalayıp doldur; Vercel'de Project → Settings → Environment Variables.

# Panele giriş şifresi (tek şifre).
ADMIN_PASSWORD=

# Oturum cookie'sini imzalayan sır — en az 16 karakter, rastgele üret:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# GitHub fine-grained token: yalnızca res-yummy reposu, Contents: Read and write.
# Panel menü JSON'unu ve görselleri bu token ile commit eder.
GITHUB_TOKEN=

# Hedef repo ve dal (verilmezse aşağıdaki varsayılanlar kullanılır).
GITHUB_REPO=OrcunSamiTandogan/res-yummy
GITHUB_BRANCH=master
