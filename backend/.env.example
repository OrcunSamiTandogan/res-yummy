# Development only. Use strong independent secrets and HTTPS in production.
APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=yummy
JWT_SECRET=replace-with-a-long-random-secret
PRIVACY_HASH_SECRET=replace-with-a-different-long-random-secret
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3000
TRUSTED_PROXY_IPS=
MEDIA_ROOT=./data/media
MEDIA_PUBLIC_PREFIX=/media
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_ATTEMPTS=5
CONTACT_WINDOW_SECONDS=3600
CONTACT_MAX_ATTEMPTS=5
CONTACT_DEDUPE_SECONDS=600
CONTACT_RETENTION_DAYS=365
MEDIA_MAX_BYTES=8388608
MEDIA_MAX_PIXELS=24000000
MEDIA_STORAGE_QUOTA_BYTES=536870912
ORPHAN_GRACE_HOURS=24
