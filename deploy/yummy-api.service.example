[Unit]
Description=Yummy Restaurant CMS API
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=yummy-api
Group=yummy-api
WorkingDirectory=/srv/yummy-cms/backend
EnvironmentFile=/etc/yummy-cms/api.env
ExecStart=/srv/yummy-cms/backend/.venv/bin/gunicorn app.main:app --workers 2 --worker-class uvicorn_worker.UvicornWorker --bind 127.0.0.1:8672 --timeout 60
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yummy-cms/media
MemoryMax=512M

[Install]
WantedBy=multi-user.target
